		{
			"name": "1. Create Article",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 201', () => pm.response.to.have.status(201));",
							"const body = pm.response.json();",
							"pm.test('mengembalikan id', () => pm.expect(body.id).to.be.a('number'));",
							"pm.collectionVariables.set('article_id', body.id);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Panduan Membangun REST API Article dengan Golang\",\n    \"content\": \"Sharing Vision membuka kelas backend engineering untuk mahasiswa tingkat akhir. Materi yang dibahas mencakup perancangan REST API, pengelolaan basis data relasional, penulisan migrasi database, hingga pengujian setiap endpoint menggunakan Postman agar peserta benar-benar siap masuk ke dunia industri.\",\n    \"category\": \"Teknologi\",\n    \"status\": \"publish\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/article/",
					"host": ["{{base_url}}"],
					"path": ["article", ""]
				},
				"description": "Membuat article baru. Title minimal 20 karakter, content minimal 200 karakter, category minimal 3 karakter, status salah satu dari publish, draft, thrash."
			},
			"response": []
		},
