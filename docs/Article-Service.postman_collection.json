			"name": "Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status 200', () => pm.response.to.have.status(200));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health/ready",
					"host": ["{{base_url}}"],
					"path": ["health", "ready"]
				},
				"description": "Memastikan service hidup dan databasenya terjangkau."
			},
			"response": []
