# Port HTTP service
APP_PORT=8080

# Jalankan migrasi otomatis saat service dinyalakan (true/false)
AUTO_MIGRATE=true

# Format log: text atau json. Level: debug, info, warn, error
LOG_FORMAT=text
LOG_LEVEL=info

# Koneksi MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warta

# Rahasia penanda tangan JWT, wajib dan minimal 32 karakter. Buat yang acak:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=warta

# Umur token, dalam format durasi Go (15m, 1h, 168h)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Batas percobaan register, login, dan refresh per menit per IP
AUTH_RATE_LIMIT=20

# Akun admin pertama, dibuat saat service menyala bila belum ada.
# Kosongkan keduanya bila tidak diperlukan.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@warta.local
ADMIN_PASSWORD=

# Folder gambar sampul yang diunggah dan batas ukurannya (MB)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Batas paging
DEFAULT_PER_PAGE=10
MAX_PER_PAGE=100

# Origin yang boleh memanggil API dari browser, pisahkan dengan koma.
# * berarti semua.
CORS_ORIGINS=*
