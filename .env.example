# development atau production. Production menolak menyala bila rahasia masih
# nilai contoh atau lemah, dan bila CORS_ORIGINS masih *.
APP_ENV=development

# Port HTTP service
APP_PORT=8080

# Jalankan migrasi otomatis saat service dinyalakan (true/false)
AUTO_MIGRATE=true

# Format log: text atau json. Level: debug, info, warn, error
LOG_FORMAT=text
LOG_LEVEL=info

# Koneksi MySQL. Dengan docker-compose.prod.yml, DB_USER otomatis "warta"
# dan DB_PASSWORD dipakai untuk membuat user itu. MYSQL_ROOT_PASSWORD hanya
# dipakai container MySQL.
MYSQL_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warta

# Rahasia penanda tangan JWT, wajib dan minimal 32 karakter. Buat yang acak:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=warta

# Umur token, dalam format durasi Go (15m, 1h, 168h)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Batas percobaan register, login, dan refresh per menit per IP
AUTH_RATE_LIMIT=20

# Batas komentar (termasuk ubah dan lapor) dan upload per menit per akun
COMMENT_RATE_LIMIT=5
UPLOAD_RATE_LIMIT=10

# Jumlah laporan dari akun berbeda yang membuat komentar disembunyikan
# otomatis sampai ditinjau admin
COMMENT_HIDE_THRESHOLD=3

# Akun admin pertama, dibuat saat service menyala bila belum ada.
# Kosongkan keduanya bila tidak diperlukan.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@warta.local
ADMIN_PASSWORD=

# Folder gambar sampul yang diunggah dan batas ukurannya (MB)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Batas paging
DEFAULT_PER_PAGE=10
MAX_PER_PAGE=100

# Origin yang boleh memanggil API dari browser, pisahkan dengan koma.
# * berarti semua (tidak diizinkan di production).
CORS_ORIGINS=*

# IP atau CIDR reverse proxy di depan service (Nginx, load balancer), pisahkan
# dengan koma. Hanya dari alamat ini header X-Forwarded-For dipercaya untuk
# menentukan IP pengunjung. Kosongkan bila service diakses langsung.
TRUSTED_PROXIES=

# Alamat frontend. Dipakai untuk tautan di email verifikasi dan reset
# password, sitemap, dan RSS. Wajib https di production.
APP_URL=http://localhost:5173

# Server SMTP untuk email verifikasi dan reset password. Kosongkan SMTP_HOST
# di development: isi email hanya dicatat ke log. Wajib di production.
# Port 465 memakai TLS langsung, port lain STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Warta <noreply@warta.local>

# Akun yang emailnya belum terverifikasi tidak bisa berkomentar dan melapor.
# Bawaan: true bila APP_ENV=production, false bila development.
REQUIRE_EMAIL_VERIFICATION=
