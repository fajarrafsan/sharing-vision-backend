# Port HTTP service
APP_PORT=8080

# Jalankan migrasi otomatis saat service dinyalakan (true/false)
AUTO_MIGRATE=true

# Koneksi MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=article

# Batas paging
DEFAULT_LIMIT=10
MAX_LIMIT=100

# Origin yang diizinkan memanggil API dari browser. * berarti semua.
CORS_ORIGIN=*
